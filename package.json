{
  "name": "wpcsa-easter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "images": "scripts/optimize-images.sh",
    "data:check": "vitest run src/data/content.test.ts",
    "data:upload": "infra/upload-data.sh",
    "data:import": "node scripts/import-sheets.ts",
    "api:build": "rm -rf api/dist && rolldown api/index.ts -d api/dist -f esm -p node -m --entry-file-names \"[name].mjs\" --chunk-file-names \"[name]-[hash].mjs\""
  },
  "dependencies": {
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@biomejs/biome": "2.5.15",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.13.3",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
